NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://automation:local-development-only@localhost:55432/automation?schema=public
POSTGRES_PASSWORD=local-development-only
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=
ADMIN_API_KEY=replace-with-a-random-key-at-least-32-characters
TIMEZONE=Asia/Kolkata
# Enable only after configuring sources, OpenAI, and Telegram.
CLIENT_AGENT_ENABLED=false
RESEARCH_AGENT_ENABLED=false
CLIENT_AGENT_DAILY_LEAD_LIMIT=6
CLIENT_AGENT_TIME=09:00
CLIENT_REGIONS=Delhi,Gurugram,Noida,Faridabad,Ghaziabad
CLIENT_CATEGORIES=Salons and beauty parlours,Gyms and fitness studios,Cafes and restaurants,Photographers/videographers,Event planners and decorators,Interior designers,Coaching/training institutes,Local boutiques/fashion stores,Bakeries,Yoga/fitness instructors,Home-service businesses,Small local agencies/service businesses
RESEARCH_CYCLE_DAYS=30
RESEARCH_START_TIME=13:00
RESEARCH_END_TIME=17:00
RESEARCH_BATCH_INTERVAL_MINUTES=30
# Search credits are separate from the OpenAI dollar budget. All attempts reserve one
# credit conservatively, including failed requests; limits reset at UTC day/month.
TAVILY_ENABLED=false
TAVILY_API_KEY=
TAVILY_MAX_RESULTS_PER_QUERY=5
TAVILY_REQUEST_TIMEOUT_MS=15000
TAVILY_MAX_RETRIES=2
TAVILY_DAILY_CREDIT_LIMIT=30
TAVILY_MONTHLY_CREDIT_LIMIT=900
TAVILY_REQUESTS_PER_MINUTE=20
CLIENT_DISCOVERY_QUERIES=3
CLIENT_DISCOVERY_CANDIDATES=8
RESEARCH_TAVILY_QUERIES=1
RESEARCH_TAVILY_EXTRACTS=1
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL_SMALL=
OPENAI_MODEL_STRONG=
# Supply current per-million token rates for each configured model. No assumed prices.
OPENAI_MODEL_PRICES={}
OPENAI_DAILY_BUDGET_USD=2
OPENAI_MONTHLY_BUDGET_USD=30
OPENAI_DISABLE_NONESSENTIAL_AT_95=true
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_FINAL_MAX_OUTPUT_TOKENS=12000
TELEGRAM_ENABLED=false
# Separate bots; both can use the shared operator chat ID below.
CLIENT_TELEGRAM_BOT_TOKEN=
RESEARCH_TELEGRAM_BOT_TOKEN=
CLIENT_TELEGRAM_CHAT_ID=
RESEARCH_TELEGRAM_CHAT_ID=
CLIENT_TELEGRAM_WEBHOOK_SECRET=
RESEARCH_TELEGRAM_WEBHOOK_SECRET=
# Legacy single-bot settings (bot token is not required with two bots).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
HTTP_TIMEOUT_MS=15000
